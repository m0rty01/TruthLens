# TruthLens Environment Configuration

# Application
NODE_ENV=development
PORT=4000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database - Local SQLite (development)
DATABASE_URL=file:local.db

# Database - Turso (production)
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# JWT
JWT_SECRET=your-jwt-secret-change-in-production

# Neo4j - Graph Database
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=truthlens_dev

# Redis
# REDIS_URL=redis://localhost:6379

# Elasticsearch
# ELASTICSEARCH_URL=http://localhost:9200

# AI Providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=

# Social Media APIs
# Reddit - Get from https://www.reddit.com/prefs/apps (create 'script' app)
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret

# YouTube - Get from https://console.cloud.google.com (enable YouTube Data API v3)
# YOUTUBE_API_KEY=your_youtube_api_key

# X/Twitter - Get from https://developer.x.com (Basic tier $100/mo or Free tier)
# X_API_BEARER_TOKEN=your_x_bearer_token

# TikTok Research API - Apply at https://developers.tiktok.com (requires approval)
# TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# Meta (Facebook/Instagram) - Get from https://developers.facebook.com
# META_ACCESS_TOKEN=your_meta_access_token

# News & Fact-Checking APIs
# NEWS_API_KEY=
# GOOGLE_FACT_CHECK_API_KEY=

# S3 Storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=truthlens-uploads
# AWS_REGION=us-east-1
